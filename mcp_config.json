{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "vercel": {
      "serverUrl": "https://mcp.vercel.com"
    },
    "supabase": {
      "serverUrl": "https://mcp.supabase.com/mcp"
    }
  }
}
